<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="JFrogNuGetProxy" value="https://jfrog.i40.ifm-datalink.net/artifactory/api/nuget/v3/vicione-nuget.org-proxy/index.json" />
    <add key="JFrogViciOne" value="https://jfrog.i40.ifm-datalink.net/artifactory/api/nuget/v3/vicione-nuget/index.json" />
    <add key="IFM-qa" value="https://jfrog.i40.ifm-datalink.net/artifactory/api/nuget/v3/suite-nuget-meta-qa/" protocolVersion="3" />
    <add key="IFM-iotcore" value="https://jfrog.i40.ifm-datalink.net/artifactory/api/nuget/v3/vse-iotcore/" protocolVersion="3" />
  </packageSources>
  <!--
  <packageSourceCredentials>
    <JFrogNuGetProxy>
        <add key="Username" value="##NuGet_User_JFrog##" />
        <add key="ClearTextPassword" value="##NuGet_PW_JFrog##" />
    </JFrogNuGetProxy>
    <JFrogViciOne>
        <add key="Username" value="##NuGet_User_RW_JFrog##" />
        <add key="ClearTextPassword" value="##NuGet_PW_RW_JFrog##" />
    </JFrogViciOne>
    <IFM-qa>
        <add key="Username" value="##NuGet_User_JFrog##" />
        <add key="ClearTextPassword" value="##NuGet_PW_JFrog##" />
    </IFM-qa>
    <IFM-iotcore>
        <add key="Username" value="##NuGet_User_JFrog##" />
        <add key="ClearTextPassword" value="##NuGet_PW_JFrog##" />
    </IFM-iotcore>
  </packageSourceCredentials>
  -->
  <packageSourceMapping>
    <packageSource key="JFrogNuGetProxy">
      <package pattern="*" />
    </packageSource>
    <packageSource key="IFM-qa">
      <package pattern="ifm*" />
      <package pattern="UnifiedAutomation.*" />
    </packageSource>
    <packageSource key="JFrogViciOne">
      <package pattern="ViciOne.*" />
      <package pattern="ACX.*" />
    </packageSource>
    <packageSource key="IFM-iotcore">
      <package pattern="ifm.diagnostic.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
